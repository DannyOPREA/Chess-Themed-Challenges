{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-themed-challenges",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The app is served at chess-themed-challenges.<account>.workers.dev. Each
  // deployed version's own preview URL is off, so only the live version is
  // reachable (an old version would run against the current database).
  "workers_dev": true,
  "preview_urls": false,
  // Copies Pico CSS and htmx from node_modules into public/vendor/ before
  // `wrangler dev` and `wrangler deploy`, so the pages load them from the app
  // itself rather than from a CDN.
  "build": {
    "command": "node scripts/copy-vendor.mjs"
  },
  "assets": {
    "directory": "./public"
  },
  "vars": {
    // Picks the content set: "test" (placeholders) or "real" (Danny's list).
    // "real" since unit 4.01, whose migration 0003 cleared the test game
    // (CLAUDE.md rule 4). Local development and tests still use "test": it is
    // set in .dev.vars (see .dev.vars.example) and in vitest.config.ts.
    "CONTENT_SET": "real"
  },
  // Secrets are set in the Cloudflare dashboard (README.md, "Deploying"),
  // locally in a git-ignored .dev.vars (copy .dev.vars.example), and in tests
  // by vitest.config.ts. Listing them here types them in worker-configuration.d.ts.
  "secrets": {
    "required": ["HOST_PASSWORD", "COOKIE_SECRET"]
  },
  // No database_id: Wrangler finds the production database by its name,
  // chess-crawl, which Danny creates in the dashboard (README.md, "Deploying").
  // Locally and in tests it is a local D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chess-crawl",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
